# Токен бота — тот же самый, что и TELEGRAM_BOT_TOKEN в .env сайта.
BOT_TOKEN=

# Адрес вашего сайта БЕЗ слэша на конце, например https://alemmod.example.com
SITE_URL=

# Уже сгенерирован и совпадает с BOT_API_SECRET в .env сайта — трогать не
# нужно, если сайт разворачиваете из этого же архива. Если меняете —
# поменяйте ОДИНАКОВО в обоих файлах.
BOT_API_SECRET=7229ebe6547d54a3847d52c691f4a8acc8ad56e8100a0f1e

# Ваш chat_id — напишите боту /start, впишите то, что он пришлёт в ответ.
ADMIN_CHAT_IDS=

# Команда перезапуска сайта — впишите под ваш способ запуска (pm2/docker/systemd).
SITE_RESTART_CMD=pm2 restart mod-hub

# Команда полной перезагрузки VPS — требует passwordless sudo, см. telegram-bot/README.md.
# Бот при этом тоже перезагрузится вместе с сервером (вернётся сам, если настроен pm2 startup).
SERVER_REBOOT_CMD=sudo systemctl reboot
