<header class="site-header">
  <div class="container">
    <a href="/" class="brand">
      <img src="/img/logo.png" alt="Alem Mod" class="mark">
      <span>Alem Mod<small>моды для Alem Colony</small></span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Открыть меню" aria-expanded="false">
      <span class="nav-toggle-icon" id="navToggleIcon">☰</span><span id="navToggleText">Меню</span>
    </button>
    <nav class="site-nav" id="siteNav">
      <div class="nav-section">Моды</div>
      <a href="/games/alem-colony"><span class="nav-ico">🗺</span><span>Все моды<span class="nav-sub">каталог с поиском и тегами</span></span></a>

      <div class="nav-section">Опубликовать</div>
      <a href="/mods/new" class="nav-accent"><span class="nav-ico">⬆</span><span>Опубликовать мод<span class="nav-sub">загрузить готовый .zip</span></span></a>
      <% if (builderEnabled) { %>
      <a href="/builder/"><span class="nav-ico">⚒</span><span>Конструктор модов<span class="nav-sub">собрать мод без ручного JSON</span></span></a>
      <% } %>

      <div class="nav-section">Мой доступ</div>
      <% if (user) { %>
        <a href="/account">
          <% if (user.avatar) { %>
            <img class="avatar avatar-nav" src="<%= user.avatar %>" alt="">
          <% } else { %>
            <span class="nav-ico">👤</span>
          <% } %>
          <span><%= user.username %><span class="nav-sub">мои моды</span></span>
        </a>
      <% } else { %>
        <a href="/login"><span class="nav-ico">🔓</span><span>Войти<span class="nav-sub">или зарегистрироваться</span></span></a>
      <% } %>
      <a href="/manage.html"><span class="nav-ico">🔑</span><span>Управление по коду<span class="nav-sub">редактировать мод без аккаунта</span></span></a>
      <% if (bugsEnabled) { %>
      <a href="/bugs"><span class="nav-ico">🐞</span><span>Баг-репорты<span class="nav-sub">только для владельца</span></span></a>
      <% } %>
    </nav>
  </div>
  <div class="orbit-strip"></div>
</header>
