<a class="mod-card" href="/mods/<%= mod.slug %>">
  <div class="cover" style="<%= mod.cover_path ? `background-image:url('${mod.cover_path}')` : '' %>">
    <% if (!mod.cover_path) { %>без обложки<% } %>
  </div>
  <div class="body">
    <h3><%= mod.name %></h3>
    <p><%= (mod.summary || '').slice(0, 90) %></p>
    <% if (mod.tags && mod.tags.length) { %>
      <div class="tag-row" style="margin-bottom:8px;">
        <% mod.tags.slice(0, 3).forEach(t => { %><span class="tag-chip"><%= t %></span><% }) %>
      </div>
    <% } %>
    <div class="meta">
      <span>⬇ <%= mod.downloads %></span>
      <span>♥ <%= mod.likes %></span>
    </div>
  </div>
</a>
