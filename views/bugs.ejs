<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section">
  <div class="section-head">
    <h2>Баг-репорты</h2>
    <a href="/bugs/new" class="btn btn-primary btn-sm">+ Сообщить о баге</a>
  </div>

  <div class="tag-row" style="margin-bottom:12px;">
    <a class="tag-chip <%= !status ? 'is-active' : '' %>" href="?sort=<%= sort %>">все · <%= (counts.open||0)+(counts.in_progress||0)+(counts.resolved||0)+(counts.wontfix||0) %></a>
    <a class="tag-chip <%= status==='open' ? 'is-active' : '' %>" href="?status=open&sort=<%= sort %>">🔴 открыт · <%= counts.open||0 %></a>
    <a class="tag-chip <%= status==='in_progress' ? 'is-active' : '' %>" href="?status=in_progress&sort=<%= sort %>">🟡 в работе · <%= counts.in_progress||0 %></a>
    <a class="tag-chip <%= status==='resolved' ? 'is-active' : '' %>" href="?status=resolved&sort=<%= sort %>">🟢 решён · <%= counts.resolved||0 %></a>
    <a class="tag-chip <%= status==='wontfix' ? 'is-active' : '' %>" href="?status=wontfix&sort=<%= sort %>">⚪ не будем чинить · <%= counts.wontfix||0 %></a>
  </div>
  <div class="sort-row" style="margin-bottom:18px;">
    <a class="tag-chip <%= sort==='new'?'is-active':'' %>" href="?sort=new<%= status?'&status='+status:'' %>">Новые</a>
    <a class="tag-chip <%= sort==='votes'?'is-active':'' %>" href="?sort=votes<%= status?'&status='+status:'' %>">По голосам</a>
  </div>

  <% if (!bugs.length) { %>
    <div class="empty-state"><p>Пока пусто.</p></div>
  <% } else { %>
    <div class="bug-list">
      <% bugs.forEach(b => { %>
        <a class="bug-row" href="/bugs/<%= b.id %>">
          <span class="badge badge-bug-<%= b.status %>"><%=
            ({open:'открыт', in_progress:'в работе', resolved:'решён', wontfix:'не будем чинить'})[b.status] %></span>
          <span class="bug-row-title"><%= b.title %></span>
          <span class="bug-row-meta">♥ <%= b.votes %> · 💬 <%= b.commentCount %><% if (b.screenshotCount) { %> · 🖼 <%= b.screenshotCount %><% } %></span>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
