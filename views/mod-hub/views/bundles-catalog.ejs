<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section">
  <div class="section-head">
    <h2>Сборки модов — <%= game.name %></h2>
    <a href="/bundles/new" class="btn btn-primary btn-sm">+ Собрать сборку</a>
  </div>

  <% if (!bundles.length) { %>
    <div class="empty-state"><p>Пока нет ни одной сборки — соберите первую минимум из двух опубликованных модов.</p></div>
  <% } else { %>
    <div class="mod-grid">
      <% bundles.forEach(b => { %>
        <a class="mod-card" href="/bundles/<%= b.public_id %>">
          <div class="cover" style="<%= b.cover_path ? `background-image:url('${b.cover_path}')` : '' %>"><% if (!b.cover_path) { %>без обложки<% } %></div>
          <div class="body">
            <h3><%= b.name %></h3>
            <p><%= (b.summary||'').slice(0,90) %></p>
            <div class="meta"><span>📦 <%= b.modCount %> модов</span><span>♥ <%= b.likes %></span></div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
