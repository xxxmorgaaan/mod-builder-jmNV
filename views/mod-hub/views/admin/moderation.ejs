<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title }) %></head>
<body>
<%- include('../partials/header') %>

<main class="container section">
  <h1>Модерация</h1>
  <%- include('_tabs', { active: 'moderation' }) %>

  <h2>Новые моды на проверке (<%= pendingMods.length %>)</h2>
  <% if (!pendingMods.length) { %><p class="hint">Пусто.</p><% } %>
  <% pendingMods.forEach(m => { %>
    <div class="mod-review-card">
      <div class="vh" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;align-items:center;">
        <div><b><%= m.name %></b> — <a href="/mods/<%= m.id %>" target="_blank">открыть превью</a> · <a href="/admin/mods/<%= m.id %>/inspect">🔍 Посмотреть файлы</a><br><span class="hint"><%= m.summary %></span>
          <% if (m.scan_note) { %><br><span class="badge badge-approved">✓ автопроверка пройдена</span><% } %></div>
        <div class="row-actions">
          <form method="post" action="/admin/mods/<%= m.id %>/approve"><button class="btn btn-primary btn-sm" type="submit">Одобрить</button></form>
          <form method="post" action="/admin/mods/<%= m.id %>/reject" onsubmit="return promptNote(this)"><input type="hidden" name="note" class="note-input"><button class="btn btn-danger btn-sm" type="submit">Отклонить</button></form>
        </div>
      </div>
    </div>
  <% }) %>

  <h2 style="margin-top:28px;">Новые версии на проверке (<%= pendingVersions.length %>)</h2>
  <% if (!pendingVersions.length) { %><p class="hint">Пусто.</p><% } %>
  <% pendingVersions.forEach(v => { %>
    <div class="mod-review-card">
      <div class="vh" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;align-items:center;">
        <div><b><%= v.mod_name %></b> → версия <b><%= v.version_label %></b> (<%= humanSize(v.file_size) %>) · <a href="/admin/mods/<%= v.mod_id %>/inspect?version=<%= v.id %>">🔍 Посмотреть файлы</a><br>
          <span class="hint"><%= v.changelog %></span>
          <% if (v.scan_note) { %><br><span class="badge badge-approved">✓ автопроверка пройдена</span><% } %></div>
        <div class="row-actions">
          <form method="post" action="/admin/mod-versions/<%= v.id %>/approve"><button class="btn btn-primary btn-sm" type="submit">Одобрить</button></form>
          <form method="post" action="/admin/mod-versions/<%= v.id %>/reject"><button class="btn btn-danger btn-sm" type="submit">Отклонить</button></form>
        </div>
      </div>
    </div>
  <% }) %>

  <h2 style="margin-top:28px;">Сборки на проверке (<%= pendingBundles.length %>)</h2>
  <% if (!pendingBundles.length) { %><p class="hint">Пусто.</p><% } %>
  <% pendingBundles.forEach(b => { %>
    <div class="mod-review-card">
      <div class="vh" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;align-items:center;">
        <div><b><%= b.name %></b> — <a href="/bundles/<%= b.public_id %>" target="_blank">открыть превью</a></div>
        <div class="row-actions">
          <form method="post" action="/admin/bundles/<%= b.public_id %>/approve"><button class="btn btn-primary btn-sm" type="submit">Одобрить</button></form>
          <form method="post" action="/admin/bundles/<%= b.public_id %>/reject"><button class="btn btn-danger btn-sm" type="submit">Отклонить</button></form>
        </div>
      </div>
    </div>
  <% }) %>
</main>

<script>
function promptNote(form){
  const note = prompt('Причина отклонения (необязательно):', '');
  form.querySelector('.note-input').value = note || '';
  return true;
}
</script>
<%- include('../partials/footer') %>
</body>
</html>
