# Токен бота — берётся у @BotFather (команда /newbot). Тот же токен, что и
# в .env самого сайта (TELEGRAM_BOT_TOKEN) — это ОДИН И ТОТ ЖЕ бот.
BOT_TOKEN=

# Адрес вашего сайта БЕЗ слэша на конце, например https://alemmod.up.railway.app
SITE_URL=

# Секрет для защищённого API бота — придумайте длинную случайную строку и
# впишите ТОЧНО ТАКУЮ ЖЕ в .env сайта, в переменную BOT_API_SECRET.
BOT_API_SECRET=

# Ваш(и) chat_id через запятую — напишите боту /start, он пришлёт chat_id
# в ответ, скопируйте его сюда. Например: 111111111,222222222
# Пока пусто — бот отвечает всем подряд (удобно для первого запуска, чтобы
# узнать свой chat_id), поэтому сразу после первого /start заполните это.
ADMIN_CHAT_IDS=

# ------------------------------------------------------- кнопки перезапуска
# Команда, которой бот перезапускает сам сайт (Node-процесс через pm2).
# Выполняется ЛОКАЛЬНО тем же способом, каким вы сами запускаете сайт:
#   если через pm2 (у вас процесс называется "mod-hub"): pm2 restart mod-hub
#   если через docker compose: docker compose -f /путь/до/проекта/docker-compose.yml restart alem-mod
#   если через systemd:        sudo systemctl restart alem-mod
# Без этой переменной кнопка «Перезапустить сайт» просто ответит ошибкой
# «команда не настроена» — ничего не сломает, но и не сработает.
SITE_RESTART_CMD=pm2 restart mod-hub

# Команда ПОЛНОЙ перезагрузки VPS целиком (не только сайта) — например,
# когда сайт стоял пару дней и всё зависло настолько, что помогает только
# полный ребут сервера. Требует passwordless sudo именно на эту команду,
# см. telegram-bot/README.md. Бот при этом тоже перезагрузится вместе с
# сервером — вернётся сам, если настроен автозапуск через pm2 startup.
SERVER_REBOOT_CMD=sudo systemctl reboot
