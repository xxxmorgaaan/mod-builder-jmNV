<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section">
  <div class="section-head">
    <h2>Все моды — <%= game.name %></h2>
    <a href="/mods/new" class="btn btn-primary btn-sm">+ Опубликовать</a>
  </div>

  <form method="get" class="search-row">
    <input type="text" name="q" value="<%= q %>" placeholder="Искать по названию или описанию…">
    <% if (tag) { %><input type="hidden" name="tag" value="<%= tag %>"><% } %>
    <input type="hidden" name="sort" value="<%= sort %>">
    <button class="btn btn-ghost" type="submit">Найти</button>
  </form>

  <% if (popularTags.length) { %>
  <div class="tag-row" style="margin-bottom:16px;">
    <a class="tag-chip <%= !tag ? 'is-active' : '' %>" href="?sort=<%= sort %><%= q ? '&q='+encodeURIComponent(q) : '' %>">все теги</a>
    <% popularTags.forEach(t => { %>
      <a class="tag-chip <%= tag === t.tag ? 'is-active' : '' %>" href="?tag=<%= encodeURIComponent(t.tag) %>&sort=<%= sort %><%= q ? '&q='+encodeURIComponent(q) : '' %>"><%= t.tag %> · <%= t.c %></a>
    <% }) %>
  </div>
  <% } %>

  <div class="sort-row" style="margin-bottom:18px;">
    <% const sorts = [['new','Новые'],['updated','Обновлённые'],['downloads','По скачиваниям'],['likes','По лайкам'],['az','По алфавиту']]; %>
    <% sorts.forEach(([key,label]) => { %>
      <a class="tag-chip <%= sort===key?'is-active':'' %>" href="?sort=<%= key %><%= tag ? '&tag='+encodeURIComponent(tag) : '' %><%= q ? '&q='+encodeURIComponent(q) : '' %>"><%= label %></a>
    <% }) %>
  </div>

  <% if (!mods.length) { %>
    <div class="empty-state">
      <p>Ничего не нашлось<% if (q || tag) { %> по этому запросу<% } %>.</p>
    </div>
  <% } else { %>
    <div class="mod-grid">
      <% mods.forEach(mod => { %><%- include('partials/mod-card', { mod }) %><% }) %>
    </div>
  <% } %>

  <% if (pages > 1) { %>
  <div class="pagination">
    <% for (let p = 1; p <= pages; p++) { %>
      <a class="<%= p===page?'is-active':'' %>" href="?page=<%= p %>&sort=<%= sort %><%= tag ? '&tag='+encodeURIComponent(tag) : '' %><%= q ? '&q='+encodeURIComponent(q) : '' %>"><%= p %></a>
    <% } %>
  </div>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
