<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section">
  <% if (bundle.status !== 'approved') { %>
    <div class="alert alert-warn">Эта сборка видна только вам по коду управления — статус: <b><%= bundle.status %></b>.</div>
  <% } %>

  <div class="mod-hero">
    <div class="cover-col">
      <div class="cover-big" style="<%= bundle.cover_path ? `background-image:url('${bundle.cover_path}')` : '' %>"></div>
    </div>
    <div class="info-col">
      <h1><%= bundle.name %></h1>
      <p><%= bundle.summary %></p>
      <div class="stat-row">
        <button type="button" class="btn btn-ghost like-btn <%= liked ? 'is-liked' : '' %>" data-like-url="/bundles/<%= bundle.public_id %>/like">
          ♥ <span class="like-count"><%= bundle.likes %></span>
        </button>
        <button type="button" class="btn btn-ghost btn-sm" onclick="navigator.share ? navigator.share({title:'<%= bundle.name %>', url: location.href}) : (navigator.clipboard.writeText(location.href), alert('Ссылка скопирована'))">Поделиться</button>
        <a class="btn btn-ghost btn-sm" href="/report/bundle/<%= bundle.public_id %>">⚠ Пожаловаться</a>
        <% if (authorized) { %>
          <a class="btn btn-ghost btn-sm" href="/bundles/<%= bundle.public_id %>/edit?code=<%= encodeURIComponent(code) %>">✏️ Редактировать</a>
        <% } else { %>
          <a class="btn btn-ghost btn-sm" href="/manage.html">🔑 Это ваша сборка? Управлять</a>
        <% } %>
      </div>
      <a class="btn btn-primary btn-block" href="/bundles/<%= bundle.public_id %>/download-all">Скачать все моды (.zip)</a>
      <% if (bundle.description) { %><h2 style="margin-top:22px;">Описание</h2><p style="white-space:pre-wrap;color:var(--text-dim);"><%= bundle.description %></p><% } %>
    </div>
  </div>

  <section style="margin-top:28px;">
    <h2>Моды в сборке (<%= mods.length %>)</h2>
    <div class="mod-grid">
      <% mods.forEach(m => { %><%- include('partials/mod-card', { mod: { ...m, tags: [] } }) %><% }) %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
