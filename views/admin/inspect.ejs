<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title }) %></head>
<body>
<%- include('../partials/header') %>

<main class="container section">
  <h1>Файлы мода: <%= mod.name %></h1>
  <p class="hint"><a href="/admin/moderation">← назад к модерации</a></p>

  <% if (versions.length > 1) { %>
  <div class="tag-row" style="margin-bottom:16px;">
    <% versions.forEach(v => { %>
      <a class="tag-chip <%= version && v.id === version.id ? 'is-active' : '' %>" href="/admin/mods/<%= mod.id %>/inspect?version=<%= v.id %>">
        <%= v.version_label %> <span class="badge badge-<%= v.status %>" style="margin-left:4px;"><%= v.status %></span>
      </a>
    <% }) %>
  </div>
  <% } %>

  <% if (error) { %><div class="alert alert-error"><%= error %></div>
  <% } else if (!version) { %><p class="hint">У этого мода пока нет ни одной версии.</p>
  <% } else { %>

  <div class="inspect-layout">
    <div class="inspect-files">
      <h2>Файлы в архиве (<%= entries.length %>)</h2>
      <ul class="inspect-file-list">
        <% entries.forEach(e => { %>
          <li>
            <button type="button" class="inspect-file-btn" data-kind="<%= e.kind %>"
              data-url="/admin/mods/<%= mod.id %>/inspect/file?version=<%= version.id %>&path=<%= encodeURIComponent(e.path) %>"
              <% if (e.path.toLowerCase().endsWith('.lua')) { %>data-lint-url="/admin/mods/<%= mod.id %>/inspect/lint-lua?version=<%= version.id %>&path=<%= encodeURIComponent(e.path) %>"<% } %>
              data-name="<%= e.path %>">
              <%= e.kind === 'image' ? '🖼' : (e.kind === 'text' ? '📄' : '📦') %> <%= e.path %>
            </button>
            <span class="hint"><%= humanSize(e.size) %></span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="inspect-preview" id="inspectPreview">
      <p class="hint">Выберите файл слева, чтобы посмотреть содержимое.</p>
    </div>
  </div>
  <% } %>
</main>

<script>
(function(){
  var preview = document.getElementById('inspectPreview');
  document.querySelectorAll('.inspect-file-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.inspect-file-btn').forEach(function(b){ b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var kind = btn.dataset.kind, url = btn.dataset.url, name = btn.dataset.name;
      if (kind === 'image') {
        preview.innerHTML = '';
        var img = document.createElement('img');
        img.src = url;
        img.className = 'inspect-image-preview';
        preview.appendChild(img);
      } else if (kind === 'text') {
        preview.innerHTML = '<p class="hint">Загрузка…</p>';
        fetch(url).then(function(r){ return r.text(); }).then(function(text){
          var wrap = document.createElement('div');
          var lintUrl = btn.dataset.lintUrl;
          if (lintUrl) {
            var lintBar = document.createElement('div');
            lintBar.className = 'lint-bar';
            var lintBtn = document.createElement('button');
            lintBtn.type = 'button';
            lintBtn.className = 'btn btn-ghost btn-sm';
            lintBtn.textContent = '🔍 Проверить синтаксис Lua';
            var lintResult = document.createElement('span');
            lintResult.className = 'hint';
            lintResult.style.marginLeft = '10px';
            lintBtn.addEventListener('click', function(){
              lintResult.textContent = 'Проверяю…';
              lintResult.className = 'hint';
              fetch(lintUrl).then(function(r){ return r.json(); }).then(function(data){
                if (data.ok) {
                  lintResult.textContent = '✅ Синтаксис в порядке.';
                  lintResult.className = 'lint-ok';
                } else {
                  lintResult.textContent = '❌ ' + (data.line ? 'Строка ' + data.line + ': ' : '') + data.error;
                  lintResult.className = 'lint-error';
                }
              }).catch(function(){
                lintResult.textContent = '❌ Не удалось выполнить проверку.';
                lintResult.className = 'lint-error';
              });
            });
            lintBar.appendChild(lintBtn);
            lintBar.appendChild(lintResult);
            wrap.appendChild(lintBar);
          }
          var pre = document.createElement('pre');
          pre.className = 'preview-code';
          try { pre.textContent = JSON.stringify(JSON.parse(text), null, 2); }
          catch (e) { pre.textContent = text; }
          wrap.appendChild(pre);
          preview.innerHTML = '';
          preview.appendChild(wrap);
        }).catch(function(){ preview.innerHTML = '<p class="hint">Не удалось загрузить файл.</p>'; });
      } else {
        preview.innerHTML = '<p class="hint">' + name + ' — этот тип файла не показывается напрямую, скачайте архив целиком, если нужно посмотреть.</p>';
      }
    });
  });
})();
</script>

<%- include('../partials/footer') %>
</body>
</html>
