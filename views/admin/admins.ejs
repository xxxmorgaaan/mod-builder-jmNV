<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title }) %></head>
<body>
<%- include('../partials/header') %>

<main class="container section">
  <h1>Админы</h1>
  <%- include('_tabs', { active: 'admins' }) %>

  <div class="table-scroll" style="margin-bottom:24px;">
    <table>
      <thead><tr><th>Логин</th><th>Роль</th><th>Создан</th><th>Действия</th></tr></thead>
      <tbody>
        <% admins.forEach(a => { %>
        <tr>
          <td><%= a.username %></td>
          <td><%= a.role === 'owner' ? 'владелец' : 'модератор' %></td>
          <td><%= a.created_at %></td>
          <td class="row-actions">
            <% if (a.role !== 'owner') { %>
              <form method="post" action="/admin/admins/<%= a.id %>/reset-password" onsubmit="return setPass(this)">
                <input type="hidden" name="password" class="pass-input">
                <button class="btn btn-ghost btn-sm" type="submit">Сбросить пароль</button>
              </form>
              <form method="post" action="/admin/admins/<%= a.id %>/delete" onsubmit="return confirm('Удалить модератора?');">
                <button class="btn btn-danger btn-sm" type="submit">Удалить</button>
              </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <h2>Добавить модератора</h2>
  <form method="post" action="/admin/admins" class="form-panel" style="max-width:420px;">
    <div class="field"><label>Логин</label><input type="text" name="username" required></div>
    <div class="field"><label>Пароль (минимум 6 символов)</label><input type="password" name="password" required minlength="6"></div>
    <button class="btn btn-primary btn-block" type="submit">Добавить</button>
  </form>
</main>

<script>
function setPass(form){
  const p = prompt('Новый пароль для этого модератора (минимум 6 символов):', '');
  if (!p || p.length < 6) return false;
  form.querySelector('.pass-input').value = p;
  return true;
}
</script>
<%- include('../partials/footer') %>
</body>
</html>
