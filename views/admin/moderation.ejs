<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title }) %></head>
<body>
<%- include('../partials/header') %>

<main class="container section">
  <h1>Модерация</h1>
  <%- include('_tabs', { active: 'moderation' }) %>

  <h2>Новые моды на проверке (<%= pendingMods.length %>)</h2>
  <% if (!pendingMods.length) { %><p class="hint">Пусто.</p><% } %>
  <% if (pendingMods.length) { %>
  <form method="post" action="/admin/mods/bulk-approve" id="modsForm">
    <input type="hidden" name="note" class="note-input">
    <% pendingMods.forEach(m => { %>
      <div class="mod-review-card">
        <div class="vh" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;align-items:flex-start;">
          <label style="display:flex;gap:10px;align-items:flex-start;cursor:pointer;">
            <input type="checkbox" name="ids" value="<%= m.id %>" style="margin-top:4px;">
            <span><b><%= m.name %></b> — <a href="/mods/<%= m.id %>" target="_blank">открыть превью</a> · <a href="/admin/mods/<%= m.id %>/inspect">🔍 Посмотреть файлы</a><br><span class="hint"><%= m.summary %></span>
              <% if (m.scan_note) { %><br><span class="badge badge-approved">✓ автопроверка пройдена</span><% } %></span>
          </label>
          <div class="row-actions">
            <button class="btn btn-primary btn-sm" type="submit" formaction="/admin/mods/<%= m.id %>/approve" formnovalidate>Одобрить</button>
            <button class="btn btn-danger btn-sm" type="submit" formaction="/admin/mods/<%= m.id %>/reject" formnovalidate onclick="return promptNote(this.form);">Отклонить</button>
          </div>
        </div>
      </div>
    <% }) %>
    <button class="btn btn-primary" type="submit" style="margin-top:10px;" onclick="return confirm('Одобрить все отмеченные моды разом?');">✅ Одобрить отмеченные</button>
  </form>
  <% } %>

  <h2 style="margin-top:28px;">Новые версии на проверке (<%= pendingVersions.length %>)</h2>
  <% if (!pendingVersions.length) { %><p class="hint">Пусто.</p><% } %>
  <% if (pendingVersions.length) { %>
  <form method="post" action="/admin/mod-versions/bulk-approve" id="versionsForm">
    <% pendingVersions.forEach(v => { %>
      <div class="mod-review-card">
        <div class="vh" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;align-items:flex-start;">
          <label style="display:flex;gap:10px;align-items:flex-start;cursor:pointer;">
            <input type="checkbox" name="ids" value="<%= v.id %>" style="margin-top:4px;">
            <span><b><%= v.mod_name %></b> → версия <b><%= v.version_label %></b> (<%= humanSize(v.file_size) %>) · <a href="/admin/mods/<%= v.mod_id %>/inspect?version=<%= v.id %>">🔍 Посмотреть файлы</a><br>
              <span class="hint"><%= v.changelog %></span>
              <% if (v.scan_note) { %><br><span class="badge badge-approved">✓ автопроверка пройдена</span><% } %></span>
          </label>
          <div class="row-actions">
            <button class="btn btn-primary btn-sm" type="submit" formaction="/admin/mod-versions/<%= v.id %>/approve" formnovalidate>Одобрить</button>
            <button class="btn btn-danger btn-sm" type="submit" formaction="/admin/mod-versions/<%= v.id %>/reject" formnovalidate>Отклонить</button>
          </div>
        </div>
      </div>
    <% }) %>
    <button class="btn btn-primary" type="submit" style="margin-top:10px;" onclick="return confirm('Одобрить все отмеченные версии разом?');">✅ Одобрить отмеченные</button>
  </form>
  <% } %>
</main>

<script>
function promptNote(form){
  const note = prompt('Причина отклонения (необязательно):', '');
  form.querySelector('.note-input').value = note || '';
  return true;
}
</script>
<%- include('../partials/footer') %>
</body>
</html>
