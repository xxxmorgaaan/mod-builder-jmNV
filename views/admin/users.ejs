<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title }) %></head>
<body>
<%- include('../partials/header') %>

<main class="container section">
  <h1>Пользователи</h1>
  <%- include('_tabs', { active: 'users' }) %>

  <p class="hint">Бан аккаунта одновременно банит и его последний известный IP — с того же адреса нельзя будет
    сразу завести новый аккаунт и продолжить публиковать моды.</p>

  <div class="table-scroll" style="margin-bottom:28px;">
    <table>
      <thead><tr><th>Логин</th><th>Телеграм</th><th>Модов</th><th>Последний IP</th><th>Статус</th><th>Регистрация</th><th>Действия</th></tr></thead>
      <tbody>
        <% users.forEach(u => { %>
        <tr>
          <td><a href="/users/<%= u.username %>" target="_blank"><%= u.username %></a></td>
          <td><%= u.telegram_username ? '@' + u.telegram_username : '—' %></td>
          <td><%= u.mods_count %></td>
          <td><%= u.last_ip || '—' %></td>
          <td><% if (u.is_banned) { %><span class="badge badge-rejected">забанен</span><% } else { %><span class="badge badge-approved">активен</span><% } %></td>
          <td><%= u.created_at %></td>
          <td class="row-actions">
            <% if (u.is_banned) { %>
              <form method="post" action="/admin/users/<%= u.id %>/unban"><button class="btn btn-ghost btn-sm" type="submit">Разбанить</button></form>
            <% } else { %>
              <form method="post" action="/admin/users/<%= u.id %>/ban" onsubmit="return confirm('Заблокировать аккаунт (и его последний IP)?');">
                <button class="btn btn-danger btn-sm" type="submit">Забанить</button>
              </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <h2>Забаненные IP-адреса</h2>
  <form method="post" action="/admin/ban-ip" class="form-panel" style="margin-bottom:16px;max-width:420px;">
    <div class="field"><label>IP-адрес</label><input type="text" name="ip" required placeholder="203.0.113.42"></div>
    <div class="field"><label>Причина (необязательно)</label><input type="text" name="reason" maxlength="200"></div>
    <button class="btn btn-danger btn-block" type="submit">Забанить IP</button>
  </form>

  <% if (!bannedIps.length) { %>
    <p class="hint">Забаненных IP пока нет.</p>
  <% } else { %>
  <div class="table-scroll">
    <table>
      <thead><tr><th>IP</th><th>Причина</th><th>Когда</th><th></th></tr></thead>
      <tbody>
        <% bannedIps.forEach(b => { %>
        <tr>
          <td><%= b.ip %></td>
          <td><%= b.reason || '—' %></td>
          <td><%= b.created_at %></td>
          <td><form method="post" action="/admin/unban-ip"><input type="hidden" name="ip" value="<%= b.ip %>"><button class="btn btn-ghost btn-sm" type="submit">Разбанить</button></form></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
