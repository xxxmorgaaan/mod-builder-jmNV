<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section" style="max-width:400px;">
  <h1>Вход</h1>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form method="post" action="/login" class="form-panel">
    <div class="field"><label>Логин</label><input type="text" name="username" required autofocus></div>
    <div class="field"><label>Пароль</label><input type="password" name="password" required></div>
    <button class="btn btn-primary btn-block" type="submit">Войти</button>
  </form>

  <% if (telegramBotUsername) { %>
  <div style="text-align:center;margin-top:16px;">
    <p class="hint" style="margin-bottom:10px;">или</p>
    <script async src="https://telegram.org/js/telegram-widget.js?22"
      data-telegram-login="<%= telegramBotUsername %>" data-size="large"
      data-auth-url="/auth/telegram/callback" data-request-access="write"></script>
  </div>
  <% } %>

  <p class="hint" style="margin-top:12px;">Нет аккаунта? <a href="/register">Зарегистрироваться</a> — или управляйте модом по коду через <a href="/manage.html">«Управление по коду»</a>, аккаунт не обязателен.</p>
</main>

<%- include('partials/footer') %>
</body>
</html>
