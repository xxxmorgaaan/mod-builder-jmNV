<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section">
  <div class="section-head">
    <h2>Личный кабинет — <%= user.username %></h2>
    <form method="post" action="/logout"><button class="btn btn-ghost btn-sm" type="submit">Выйти</button></form>
  </div>

  <% if (saved) { %><div class="alert alert-ok">Сохранено.</div><% } %>
  <% if (claimed) { %><div class="alert alert-ok">Мод привязан к вашему аккаунту.</div><% } %>
  <% if (claimError) { %><div class="alert alert-error"><%= claimError %></div><% } %>

  <div class="profile-card">
    <% if (me.avatar_path) { %>
      <img class="avatar avatar-lg" src="<%= me.avatar_path %>" alt="">
    <% } else { %>
      <span class="avatar avatar-lg avatar-letter"><%= user.username.trim().charAt(0).toUpperCase() %></span>
    <% } %>
    <div class="profile-card-body">
      <b><%= user.username %></b>
      <p class="hint">Аватарка показывается рядом с вашими комментариями. Необязательна — без неё будет кружок с первой буквой логина.</p>
      <form method="post" action="/account/avatar" enctype="multipart/form-data" class="profile-avatar-form">
        <input type="file" name="avatar" accept="image/png,image/jpeg,image/webp" required>
        <button class="btn btn-ghost btn-sm" type="submit">Загрузить</button>
        <% if (me.avatar_path) { %>
          <button class="btn btn-ghost btn-sm btn-danger" formaction="/account/avatar/delete" formenctype="application/x-www-form-urlencoded" type="submit">Убрать</button>
        <% } %>
      </form>
    </div>
  </div>

  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px;">
    <a class="btn btn-primary btn-sm" href="/mods/new">+ Опубликовать мод</a>
  </div>

  <h2>Привязать мод по коду</h2>
  <p class="hint">Опубликовали мод раньше без аккаунта, только по коду управления? Введите код — мод появится здесь и в вашем публичном профиле.</p>
  <form method="post" action="/account/claim-mod" class="form-panel" style="max-width:420px;margin-bottom:28px;">
    <div class="field">
      <label>Код управления модом</label>
      <input type="text" name="code" required placeholder="kylysh-a1b2c.xxxxxxxxxxxxxx">
    </div>
    <button class="btn btn-ghost btn-block" type="submit">Присвоить мод себе</button>
  </form>

  <h2>Мои моды (<%= mods.length %>)</h2>
  <% if (!mods.length) { %>
    <p class="hint">Пока ничего не опубликовано.</p>
  <% } else { %>
  <div class="table-scroll" style="margin-bottom:28px;">
    <table>
      <thead><tr><th>Название</th><th>Статус</th><th>Код (на всякий случай)</th><th>Действия</th></tr></thead>
      <tbody>
        <% mods.forEach(m => { %>
        <tr>
          <td><a href="/mods/<%= m.id %>" target="_blank"><%= m.name %></a></td>
          <td><span class="badge badge-<%= m.status %>"><%= m.status %></span></td>
          <td><% if (m.controlCode) { %><code class="code-pill" data-copy="<%= m.controlCode %>" title="Скопировать"><%= m.controlCode %></code><% } %></td>
          <td class="row-actions"><a class="btn btn-ghost btn-sm" href="/mods/<%= m.id %>/edit">✏️ Редактировать</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>

<script>
document.querySelectorAll('[data-copy]').forEach(function(el){
  el.addEventListener('click', function(){
    navigator.clipboard.writeText(el.dataset.copy).then(function(){
      var old = el.textContent;
      el.textContent = 'Скопировано!';
      setTimeout(function(){ el.textContent = old; }, 1200);
    });
  });
});
</script>
<%- include('partials/footer') %>
</body>
</html>
