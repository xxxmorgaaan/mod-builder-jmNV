<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section">
  <% if (mod.status !== 'approved') { %>
    <div class="alert alert-warn">
      Этот мод виден только вам по коду управления — статус: <b><%= mod.status %></b><% if (mod.moderation_note) { %>, комментарий модератора: «<%= mod.moderation_note %>»<% } %>.
    </div>
  <% } %>

  <div class="mod-hero">
    <div class="cover-col">
      <div class="cover-big" style="<%= mod.cover_path ? `background-image:url('${mod.cover_path}')` : '' %>"></div>
      <% if (screenshots.length) { %>
      <div class="gallery">
        <% screenshots.forEach(s => { %><img src="<%= s.path %>" data-full="<%= s.path %>" alt="Скриншот"><% }) %>
      </div>
      <% } %>
    </div>

    <div class="info-col">
      <h1><%= mod.name %></h1>
      <% if (tags.length) { %>
      <div class="tag-row" style="margin-bottom:12px;">
        <% tags.forEach(t => { %><a class="tag-chip" href="/games/<%= game.slug %>?tag=<%= encodeURIComponent(t) %>"><%= t %></a><% }) %>
      </div>
      <% } %>
      <p><%= mod.summary %></p>
      <% if (author) { %>
        <p class="hint" style="display:flex;align-items:center;gap:6px;">
          Автор:
          <% if (author.avatar_path) { %>
            <img class="avatar avatar-sm" src="<%= author.avatar_path %>" alt="" style="width:20px;height:20px;border-radius:50%;">
          <% } else { %>
            <span class="avatar avatar-sm avatar-letter" style="width:20px;height:20px;font-size:11px;"><%= author.username.trim().charAt(0).toUpperCase() %></span>
          <% } %>
          <a href="/users/<%= author.username %>"><%= author.username %></a>
        </p>
      <% } %>

      <div class="stat-row">
        <button type="button" class="btn btn-ghost like-btn <%= liked ? 'is-liked' : '' %>" data-like-url="/mods/<%= mod.id %>/like">
          ♥ <span class="like-count"><%= mod.likes %></span>
        </button>
        <span class="btn btn-ghost btn-sm" style="cursor:default;">⬇ <%= mod.downloads %> скачиваний</span>
        <button type="button" class="btn btn-ghost btn-sm" onclick="navigator.share ? navigator.share({title:'<%= mod.name %>', url: location.href}) : (navigator.clipboard.writeText(location.href), alert('Ссылка скопирована'))">Поделиться</button>
        <a class="btn btn-ghost btn-sm" href="/report/mod/<%= mod.id %>">⚠ Пожаловаться</a>
        <% if (authorized) { %>
          <a class="btn btn-ghost btn-sm" href="/mods/<%= mod.id %>/edit?code=<%= encodeURIComponent(code) %>">✏️ Редактировать</a>
        <% } else { %>
          <a class="btn btn-ghost btn-sm" href="/manage.html">🔑 Это ваш мод? Управлять</a>
        <% } %>
      </div>

      <% if (versions.length) { %>
        <a class="btn btn-primary btn-block" href="/mods/<%= mod.id %>/download/<%= versions[0].id %><%= code ? '?code='+encodeURIComponent(code) : '' %>">
          Скачать <%= versions[0].version_label %> · <%= (versions[0].file_size/1024/1024).toFixed(1) %> МБ
        </a>
      <% } else { %>
        <div class="alert alert-warn">Одобренных файлов пока нет.</div>
      <% } %>

      <% if (mod.description) { %>
        <h2 style="margin-top:24px;">Описание</h2>
        <p style="white-space:pre-wrap;color:var(--text-dim);"><%= mod.description %></p>
      <% } %>
    </div>
  </div>

  <% if (versions.length) { %>
  <section style="margin-top:32px;">
    <h2>История версий</h2>
    <% versions.forEach(v => { %>
      <div class="version-item">
        <div class="vh">
          <b><%= v.version_label %></b>
          <span class="badge badge-<%= v.status %>"><%= v.status %></span>
          <a class="btn btn-ghost btn-sm" href="/mods/<%= mod.id %>/download/<%= v.id %><%= code ? '?code='+encodeURIComponent(code) : '' %>">Скачать</a>
        </div>
        <% if (v.changelog) { %><div class="changelog"><%= v.changelog %></div><% } %>
      </div>
    <% }) %>
  </section>
  <% } %>

  <% if (similar.length) { %>
  <section style="margin-top:32px;">
    <h2>Похожие моды</h2>
    <div class="mod-grid">
      <% similar.forEach(m => { %><%- include('partials/mod-card', { mod: { ...m, tags: [] } }) %><% }) %>
    </div>
  </section>
  <% } %>

  <section style="margin-top:32px;">
    <h2>Комментарии (<%= comments.length %>)</h2>
    <form method="post" action="/mods/<%= mod.id %>/comments" class="form-panel" style="margin-bottom:16px;">
      <% if (user) { %>
        <p class="hint" style="margin-bottom:10px;">Вы пишете как <b><%= user.username %></b>.</p>
      <% } else { %>
        <div class="field">
          <label>Имя</label>
          <input type="text" name="author_name" maxlength="40" placeholder="Гость">
          <p class="hint">Можно писать как гость. <a href="/login">Войдите</a>, чтобы комментарии шли под вашим именем и аватаркой.</p>
        </div>
      <% } %>
      <div class="field"><label>Комментарий</label><textarea name="body" maxlength="2000" required></textarea></div>
      <button class="btn btn-primary" type="submit">Отправить</button>
    </form>
    <% comments.forEach(c => { %>
      <div class="comment">
        <div class="comment-head">
          <% if (c.author_avatar) { %>
            <img class="avatar avatar-sm" src="<%= c.author_avatar %>" alt="">
          <% } else { %>
            <span class="avatar avatar-sm avatar-letter <%= c.user_id ? '' : 'is-guest' %>"><%= (c.author_name || '?').trim().charAt(0).toUpperCase() %></span>
          <% } %>
          <div>
            <% if (c.user_id && c.author_username) { %>
              <a class="author" href="/users/<%= c.author_username %>"><%= c.author_name %></a>
            <% } else { %>
              <span class="author"><%= c.author_name %></span>
            <% } %>
            <% if (!c.user_id) { %><span class="guest-tag">гость</span><% } %>
            <span class="when"><%= c.created_at %></span>
          </div>
        </div>
        <p><%= c.body %></p>
        <div class="comment-actions">
          <a href="/report/comment/<%= c.id %>">⚠ Пожаловаться</a>
          <% if (c.canDelete) { %>
            <form method="post" action="/mods/<%= mod.id %>/comments/<%= c.id %>/delete" onsubmit="return confirm('Удалить этот комментарий?');" style="display:inline;">
              <% if (code) { %><input type="hidden" name="code" value="<%= code %>"><% } %>
              <button type="submit" class="is-danger">🗑 Удалить</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
