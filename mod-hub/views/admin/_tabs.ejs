<div class="admin-tabs">
  <a href="/admin/moderation" class="<%= active==='moderation'?'is-active':'' %>">Модерация</a>
  <% if (adminLevel >= 2) { %><a href="/admin/mods" class="<%= active==='mods'?'is-active':'' %>">Моды</a><% } %>
  <a href="/admin/complaints" class="<%= active==='complaints'?'is-active':'' %>">Жалобы</a>
  <a href="/admin/bugs" class="<%= active==='bugs'?'is-active':'' %>">Баг-репорты</a>
  <% if (adminLevel >= 2) { %><a href="/admin/users" class="<%= active==='users'?'is-active':'' %>">Пользователи</a><% } %>
  <a href="/admin/log" class="<%= active==='log'?'is-active':'' %>">Журнал</a>
  <% if (adminLevel >= 3) { %><a href="/admin/admins" class="<%= active==='admins'?'is-active':'' %>">Админы</a><% } %>
  <a href="/admin/settings" class="<%= active==='settings'?'is-active':'' %>">Настройки</a>
  <form method="post" action="/admin/logout" style="margin-left:auto;">
    <button class="btn btn-ghost btn-sm" type="submit"><%= roleLabel %> · <%= admin.username %> — выйти</button>
  </form>
</div>
