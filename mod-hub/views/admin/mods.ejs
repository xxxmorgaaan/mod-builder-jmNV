<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title }) %></head>
<body>
<%- include('../partials/header') %>

<main class="container section">
  <h1>Все моды</h1>
  <%- include('_tabs', { active: 'mods' }) %>

  <p class="hint">Столбец «Код» — тот самый код управления, который получил автор при публикации. Если он его потерял и написал вам в ЛС — скопируйте и пришлите обратно. Если код есть, но сайт всё равно говорит «не подходит» (испорчен/не совпадает) — жмите «🔄 Новый код»: старый перестанет действовать, а новый сразу появится в этой таблице, перешлите его автору. Скачивания и лайки — тоже можно поправить вручную (например, после сбойного импорта или переноса мода) — каждое изменение попадает в журнал действий.</p>
  <div style="margin-bottom:14px;"><a class="btn btn-ghost btn-sm" href="/admin/mods/export.csv">⬇ Экспорт в CSV</a></div>

  <div class="table-scroll">
    <table>
      <thead><tr><th>Название</th><th>Статус</th><th>Теги</th><th>Код управления</th><th>Скачиваний</th><th>Лайков</th><th>Создан</th><th>Действия</th></tr></thead>
      <tbody>
        <% mods.forEach(m => { %>
        <tr>
          <td><a href="/mods/<%= m.id %>" target="_blank"><%= m.name %></a></td>
          <td><span class="badge badge-<%= m.status %>"><%= m.status %></span></td>
          <td>
            <form method="post" action="/admin/mods/<%= m.id %>/tags" style="display:flex;gap:4px;min-width:180px;">
              <input type="text" name="tags" value="<%= m.tagsList %>" placeholder="через запятую" style="font-size:12px;padding:4px 6px;">
              <button class="btn btn-ghost btn-sm" type="submit" title="Сохранить теги">💾</button>
            </form>
          </td>
          <td>
            <% if (m.controlCode) { %>
              <code class="code-pill" data-copy="<%= m.controlCode %>" title="Нажмите, чтобы скопировать"><%= m.controlCode %></code>
            <% } else { %>
              <span class="hint">не удалось расшифровать</span>
            <% } %>
            <form method="post" action="/admin/mods/<%= m.id %>/regenerate-code"
              onsubmit="return confirm('Старый код перестанет работать. Выдать новый и показать в таблице?');" style="margin-top:4px;">
              <button class="btn btn-ghost btn-sm" type="submit" title="Если старый код не подходит — выдать новый">🔄 Новый код</button>
            </form>
          </td>
          <td>
            <form method="post" action="/admin/mods/<%= m.id %>/stats" style="display:flex;gap:4px;">
              <input type="number" name="downloads" value="<%= m.downloads %>" min="0" style="width:70px;font-size:12px;padding:4px 6px;">
              <input type="hidden" name="likes" value="<%= m.likes %>">
              <button class="btn btn-ghost btn-sm" type="submit" title="Сохранить">💾</button>
            </form>
          </td>
          <td>
            <form method="post" action="/admin/mods/<%= m.id %>/stats" style="display:flex;gap:4px;">
              <input type="hidden" name="downloads" value="<%= m.downloads %>">
              <input type="number" name="likes" value="<%= m.likes %>" min="0" style="width:70px;font-size:12px;padding:4px 6px;">
              <button class="btn btn-ghost btn-sm" type="submit" title="Сохранить">💾</button>
            </form>
          </td>
          <td><%= m.created_at %></td>
          <td class="row-actions">
            <a class="btn btn-ghost btn-sm" href="/admin/mods/<%= m.id %>/inspect">🔍 Файлы</a>
            <form method="post" action="/admin/mods/<%= m.id %>/visibility"><button class="btn btn-ghost btn-sm" type="submit"><%= m.status === 'hidden' ? 'Вернуть в витрину' : 'Скрыть' %></button></form>
            <form method="post" action="/admin/mods/<%= m.id %>/delete" onsubmit="return confirm('Удалить мод навсегда?');"><button class="btn btn-danger btn-sm" type="submit">Удалить</button></form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>

<script>
document.querySelectorAll('[data-copy]').forEach(function(el){
  el.addEventListener('click', function(){
    navigator.clipboard.writeText(el.dataset.copy).then(function(){
      var old = el.textContent;
      el.textContent = 'Скопировано!';
      setTimeout(function(){ el.textContent = old; }, 1200);
    });
  });
});
</script>
<%- include('../partials/footer') %>
</body>
</html>
