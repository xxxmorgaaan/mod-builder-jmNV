<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title }) %></head>
<body>
<%- include('../partials/header') %>

<main class="container section">
  <h1>Баг-репорты</h1>
  <%- include('_tabs', { active: 'bugs' }) %>

  <div class="alert alert-warn">
    Раздел <code>/bugs</code> открыт только владельцу сайта — обычные игроки и модераторы получают там 404,
    и ссылок на него в шапке/подвале не видят.
  </div>

  <% if (!bugs.length) { %>
    <p class="hint">Пока ни одного репорта.</p>
  <% } else { %>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Заголовок</th><th>Статус</th><th>Голосов</th><th>Создан</th><th>Действия</th></tr></thead>
      <tbody>
        <% bugs.forEach(b => { %>
        <tr>
          <td><a href="/bugs/<%= b.id %>" target="_blank"><%= b.title %></a></td>
          <td><span class="badge badge-bug-<%= b.status %>"><%= b.status %></span></td>
          <td><%= b.votes %></td>
          <td><%= b.created_at %></td>
          <td class="row-actions">
            <form method="post" action="/admin/bugs/<%= b.id %>/status">
              <select name="status" onchange="this.form.submit()">
                <option value="open" <%= b.status==='open'?'selected':'' %>>открыт</option>
                <option value="in_progress" <%= b.status==='in_progress'?'selected':'' %>>в работе</option>
                <option value="resolved" <%= b.status==='resolved'?'selected':'' %>>решён</option>
                <option value="wontfix" <%= b.status==='wontfix'?'selected':'' %>>не будем чинить</option>
              </select>
            </form>
            <form method="post" action="/admin/bugs/<%= b.id %>/delete" onsubmit="return confirm('Удалить репорт навсегда?');">
              <button class="btn btn-danger btn-sm" type="submit">Удалить</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
