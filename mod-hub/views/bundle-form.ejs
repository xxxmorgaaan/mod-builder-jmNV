<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section" style="max-width:640px;">
  <h1><%= mode === 'create' ? 'Собрать сборку' : 'Редактировать сборку: ' + bundle.name %></h1>

  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <% if (availableMods.length >= 2 || mode === 'edit') { %>
  <form method="post" action="<%= mode === 'create' ? '/bundles' : '/bundles/' + bundle.public_id %>" enctype="multipart/form-data" class="form-panel">
    <% if (mode === 'edit') { %><input type="hidden" name="code" value="<%= code %>"><% } %>

    <div class="field">
      <label>Название сборки *</label>
      <input type="text" name="name" required maxlength="80" value="<%= mode==='edit' ? bundle.name : '' %>">
    </div>
    <div class="field">
      <label>Краткое описание</label>
      <input type="text" name="summary" maxlength="160" value="<%= mode==='edit' ? (bundle.summary||'') : '' %>">
    </div>
    <div class="field">
      <label>Полное описание</label>
      <textarea name="description" maxlength="6000"><%= mode==='edit' ? (bundle.description||'') : '' %></textarea>
    </div>
    <div class="field">
      <label>Обложка</label>
      <input type="file" name="cover" accept="image/png,image/jpeg,image/webp">
    </div>
    <div class="field">
      <label>Моды в сборке * (минимум 2)</label>
      <div class="checkbox-grid">
        <% availableMods.forEach(m => { %>
          <label><input type="checkbox" name="mod_ids" value="<%= m.id %>" <%= selected.includes(m.id) ? 'checked' : '' %>> <%= m.name %></label>
        <% }) %>
      </div>
    </div>

    <% if (mode === 'create') { %>
      <p class="hint">После отправки сборка уйдёт на проверку администрации, как и обычные моды. Сразу после публикации вы получите код управления.</p>
    <% } %>

    <button class="btn btn-primary btn-block" type="submit"><%= mode === 'create' ? 'Опубликовать (на проверку)' : 'Сохранить изменения' %></button>
  </form>
  <% } %>

  <% if (mode === 'edit') { %>
    <h2 style="margin-top:32px;color:var(--danger);">Опасная зона</h2>
    <form method="post" action="/bundles/<%= bundle.public_id %>/delete" class="form-panel" onsubmit="return confirm('Удалить сборку навсегда?');">
      <input type="hidden" name="code" value="<%= code %>">
      <button class="btn btn-danger btn-block" type="submit">Удалить сборку</button>
    </form>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
