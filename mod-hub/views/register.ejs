<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/header') %>

<main class="container section" style="max-width:400px;">
  <h1>Регистрация</h1>
  <p class="hint">Необязательно — можно публиковать моды и без аккаунта, по коду управления. Аккаунт просто удобнее: все ваши моды видно в одном месте, без кодов.</p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form method="post" action="/register" class="form-panel">
    <div class="field"><label>Логин</label><input type="text" name="username" required minlength="3" autofocus></div>
    <div class="field"><label>Пароль (минимум 6 символов)</label><input type="password" name="password" required minlength="6"></div>
    <div class="field"><label>Повторите пароль</label><input type="password" name="password2" required minlength="6"></div>
    <button class="btn btn-primary btn-block" type="submit">Создать аккаунт</button>
  </form>

  <% if (telegramBotUsername) { %>
  <div style="text-align:center;margin-top:16px;">
    <p class="hint" style="margin-bottom:10px;">или заведите аккаунт в один клик через Telegram</p>
    <script async src="https://telegram.org/js/telegram-widget.js?22"
      data-telegram-login="<%= telegramBotUsername %>" data-size="large"
      data-auth-url="/auth/telegram/callback" data-request-access="write"></script>
  </div>
  <% } %>

  <p class="hint" style="margin-top:12px;">Уже есть аккаунт? <a href="/login">Войти</a></p>
</main>

<%- include('partials/footer') %>
</body>
</html>
