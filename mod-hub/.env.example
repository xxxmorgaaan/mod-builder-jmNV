# Скопируйте в .env и поменяйте значения перед первым запуском.

PORT=3000

# Секрет для подписи сессионных cookie — впишите свою длинную случайную строку.
SESSION_SECRET=change-me-to-a-long-random-string

# Ключ шифрования кодов управления модами/сборками (чтобы админ мог
# посмотреть код и подсказать автору, если тот его потерял — раздел 4 в
# README). ВАЖНО: смена этого значения делает нечитаемыми уже выданные
# коды — меняйте один раз и постоянно, не туда-сюда.
ENCRYPTION_KEY=change-me-to-a-long-random-string-too

# Логин и пароль владельца админки — создаются автоматически при первом запуске,
# если в базе ещё нет ни одного админа. Смените пароль на вкладке «Настройки»
# сразу после первого входа.
OWNER_LOGIN=owner
OWNER_PASSWORD=change-me-now

# Через сколько минут мод/версия/сборка публикуются САМИ, если админ за это
# время не одобрил и не отклонил вручную. К этому моменту запись УЖЕ прошла
# автопроверку (вирусы + структура, см. src/scan.js) — иначе она вообще не
# попала бы в базу. Это окно — не «проверка», а время на ручной пригляд.
# 0 — выключить автопубликацию полностью, только ручная модерация.
AUTO_APPROVE_MINUTES=2

# Если вход в админку перестал пускать по паролю из строки выше — почти
# всегда причина в том, что пароль в .env поменяли ПОСЛЕ первого запуска,
# а в уже существующей базе остался старый хэш (редеплой сам его не трогает,
# чтобы не сбрасывать пароль, который сменили через «Настройки»). Чтобы
# принудительно синхронизировать логин/пароль владельца с этим файлом —
# поставьте true, задеплойте, войдите, затем верните обратно false.
SYNC_OWNER_PASSWORD=false

# Баг-трекер (/bugs) и конструктор модов (/builder/) доступны только
# владельцу сайта — отдельных переменных для них нет, всё решает роль
# аккаунта, под которым вы вошли в админку.


# Более надёжный способ восстановить доступ, если вход всё равно не
# работает (например, непонятно, подхватились ли переменные окружения).
# Задайте сюда любую длинную случайную строку, задеплойте, откройте
# /admin/emergency-reset — страница сразу же (без перезапуска) впишет
# новый логин/пароль владельца прямо в базу. После успешного входа уберите
# эту переменную — без неё страница отвечает 404, будто её и нет.
RESET_TOKEN=

# Автор и сопровождающий сайта (виден в подвале каждой страницы).
SITE_AUTHOR_NAME=МОРГАН
SITE_AUTHOR_TELEGRAM=@Xxmorgaan

# Telegram-канал РАЗРАБОТЧИКА ИГРЫ Alem Colony (не путать с автором сайта выше).
GAME_DEV_TELEGRAM=@alemcolony

# Конструктор модов теперь часть этого же сайта (папка public/builder) и
# открывается по /builder/. Эту переменную можно не трогать — она нужна
# только если когда-нибудь захотите вынести конструктор на отдельный домен.

# Публичный адрес ЭТОГО сайта после деплоя (например, на Railway) — если
# задан, сервер сам пингует себя на /healthz каждые несколько минут, чтобы
# не засыпал. Для надёжности всё равно рекомендуется ВНЕШНИЙ пинг
# (UptimeRobot / cron-job.org → GET https://ваш-домен/healthz раз в 5 минут) —
# он работает, даже если сам процесс уже уснул, а самопинг изнутри — нет.
# Рекламный блок Яндекса (РСЯ) в подвале — один на страницу. Впишите id
# блока из кабинета РСЯ (например R-A-1234567-1). Пока пусто — рекламы нет
# и скрипты Яндекса вообще не подключаются.
YANDEX_AD_BLOCK_ID=

PUBLIC_URL=https://your-app.up.railway.app

# Проверка загружаемых архивов на вирусы через ClamAV — необязательно.
# Эвристическая проверка (исполняемые файлы внутри zip, zip-бомбы) работает
# всегда и без этих переменных. Полноценное сканирование по базе сигнатур
# включится, только если тут true И на сервере реально установлен ClamAV
# (см. Dockerfile в этом репозитории — он его ставит). Если true, а ClamAV
# не найден — сервер не упадёт, просто напишет в scan_note, что проверки
# не было, и админ увидит это в очереди модерации.
CLAMAV_ENABLED=false
# Один из вариантов ниже — сокет ИЛИ хост+порт, не оба сразу:
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_HOST=
CLAMAV_PORT=

# ------------------------------------------------------------- Telegram
# Бот заводится через @BotFather (команда /newbot). Всё ниже необязательно —
# без этих переменных сайт работает как раньше, просто без уведомлений и
# без входа через Telegram.

# Токен бота — им же уведомления шлются, им же подписи входа через Telegram
# Login Widget проверяются. Берётся у @BotFather после /newbot.
TELEGRAM_BOT_TOKEN=

# ID чата (личка администратора или отдельный чат/канал), куда бот будет
# слать уведомления о новых модах/версиях, отправленных на модерацию.
# Можно указать несколько через запятую, если админов несколько —
# уведомление уйдёт каждому в личку: 111111111,222222222
# Быстрый способ узнать свой chat_id — написать боту @userinfobot.
# ВАЖНО: чтобы бот вообще мог написать админу в личку, тот сначала должен
# сам написать боту (нажать /start в чате с ним) — так требует Telegram,
# бот не может первым начать диалог с человеком.
TELEGRAM_ADMIN_CHAT_ID=

# Юзернейм бота БЕЗ @ — нужен, чтобы показать кнопку «Войти через Telegram»
# на страницах входа/регистрации. Не забудьте выполнить у @BotFather
# команду /setdomain и указать домен именно этого сайта — без этого виджет
# Telegram откажется работать.
TELEGRAM_BOT_USERNAME=

# Секрет для собственного Telegram-бота модерации (папка /telegram-bot —
# отдельная программа, которую вы запускаете сами через Termux или на VPS,
# см. telegram-bot/README.md). Придумайте длинную случайную строку и
# впишите ТОЧНО ТАКУЮ ЖЕ в .env бота, в переменную BOT_API_SECRET. Без неё
# API бота (/api/bot/*) выключен и отвечает 404, как будто его нет.
BOT_API_SECRET=
